#!/usr/bin/env python3
"""
Katlans CLI wrapper — makes `katlans` work from any directory.
Auto-detects project root and sets up PATH for GCC.
"""
import sys
import os
import subprocess


def main():
    # Find the real katlans.py — resolve symlinks and directory changes
    wrapper_dir = os.path.dirname(os.path.abspath(__file__))
    
    # The actual code lives in the same directory as this wrapper
    katlans_py = os.path.join(wrapper_dir, "katlans.py")
    
    if not os.path.exists(katlans_py):
        print(f"[Error] katlans.py not found at {katlans_py}", file=sys.stderr)
        sys.exit(1)
    
    # Try to find and set up GCC path (WinLibs/MinGW installation)
    gcc_paths = [
        os.path.expanduser(
            "~/AppData/Local/Microsoft/WinGet/Packages/"
            "BrechtSanders.WinLibs.MCF.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/"
            "mingw64/bin"
        ),
    ]
    
    env = os.environ.copy()
    for gp in gcc_paths:
        if os.path.exists(os.path.join(gp, "gcc.exe")):
            env["PATH"] = gp + os.pathsep + env.get("PATH", "")
            break
    
    # Run the actual katlans.py
    cmd = [sys.executable, katlans_py] + sys.argv[1:]
    result = subprocess.run(cmd, env=env)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
