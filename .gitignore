# ─────────────────────────────────────────────────────────────────────────────
# Katlans  —  .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Build artifacts
build/
dist/
*.spec
katlans.exe

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/

# Test outputs
test_out.txt
test_dir/

# Generated C files (reproducible from .kl)
*.c

# Legacy bloat — old backup copies & docs
files/mnt/
🚀 Katlans Language — Official Documentation/

# Redundant files in files/ subdirectory
files/pyproject.toml
files/README.md
files/.gitignore
files/katlans

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
